<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CareldVision" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- TV specific -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        
        <!-- Focus -->
        <item name="android:colorFocusedHighlight">@color/focus</item>
    </style>

    <style name="Theme.CareldVision.Fullscreen" parent="Theme.CareldVision">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- TV Button Style -->
    <style name="TvButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_tv_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <!-- TV Input Style -->
    <style name="TvInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_tv_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:padding">16dp</item>
    </style>

</resources>
