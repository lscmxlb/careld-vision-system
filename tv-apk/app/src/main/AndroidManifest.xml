<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- TV specific features -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />

    <application
        android:name=".CareldVisionApp"
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CareldVision"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- Main Activity - TV Launcher -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Device Login Activity -->
        <activity
            android:name=".ui.login.DeviceLoginActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Store Binding Activity -->
        <activity
            android:name=".ui.login.StoreBindingActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Calibration Activity -->
        <activity
            android:name=".ui.calibration.CalibrationActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Vision Test Activity -->
        <activity
            android:name=".ui.vision.VisionTestActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision.Fullscreen" />

        <!-- Child Search Activity -->
        <activity
            android:name=".ui.child.ChildSearchActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Child Detail Activity -->
        <activity
            android:name=".ui.child.ChildDetailActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Vision Record Entry Activity -->
        <activity
            android:name=".ui.vision.VisionRecordActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Sync Status Activity -->
        <activity
            android:name=".ui.sync.SyncStatusActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Sync Log Activity -->
        <activity
            android:name=".ui.sync.SyncLogActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.CareldVision" />

        <!-- Network Monitor Service -->
        <service
            android:name=".service.NetworkMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Sync Worker Service -->
        <service
            android:name=".service.SyncWorkerService"
            android:enabled="true"
            android:exported="false" />

        <!-- Boot Receiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Work Manager Initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>
