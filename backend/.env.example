# ============================================================
# Careld 后端服务 - 本地开发环境变量配置模板
# ============================================================
# 使用方法: cp .env.example .env  然后填写实际值
# ============================================================

# ---- MySQL 数据库 ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=<请使用实际密码>
MYSQL_USE_SSL=false

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<请使用实际密码>
REDIS_DATABASE=0

# ---- JWT 密钥 ----
JWT_SECRET=<请替换为随机字符串>
JWT_REFRESH_SECRET=<请替换为随机字符串>

# ---- 加密密钥 (必须恰好32字符) ----
ENCRYPTION_KEY=<请替换为恰好32字符的字符串>
