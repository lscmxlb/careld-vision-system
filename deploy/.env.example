# ============================================================
# Careld 视力养护系统 - 环境变量配置模板
# ============================================================
# 使用方法: cp .env.example .env  然后填写实际值
# 重要: 不要将 .env 文件提交到版本控制!
# ============================================================

# ---- Spring 配置 ----
SPRING_PROFILES_ACTIVE=dev

# ---- MySQL 数据库 ----
MYSQL_ROOT_PASSWORD=<请使用强密码>
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=<请使用强密码>
REDIS_PORT_EXPOSE=6379

# ---- JWT 密钥 (至少64字符的随机字符串) ----
# 生成命令: openssl rand -base64 48
JWT_SECRET=<请替换为随机字符串>
JWT_REFRESH_SECRET=<请替换为随机字符串>

# ---- 加密密钥 (必须恰好32字符) ----
ENCRYPTION_KEY=<请替换为恰好32字符的字符串>
